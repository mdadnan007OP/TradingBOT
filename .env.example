# Forex Trading Bot - Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control. Never store broker passwords or API keys here.

# Trading mode: simulation | demo | live
# live mode is LOCKED in Phase 1. Only simulation/demo are allowed.
TRADING_MODE=simulation

# Live trading master kill-switch. Must remain False until a later phase.
ENABLE_LIVE_TRADING=false

# Default symbol universe (broker availability must be verified later)
DEFAULT_SYMBOLS=XAUUSD,XAGUSD,EURUSD,GBPUSD,USDJPY

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log output directory
LOG_DIR=logs

# Risk defaults (percentages as decimals)
DEFAULT_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05
MAX_POSITIONS=5
